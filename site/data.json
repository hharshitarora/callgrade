   "id": "h-p03-invented-deposit-cap",
   "title": "A lie that sounds fine",
   "takeaway": "The agent quotes a deposit cap the policy does not have. No timing check can see this. The judge does, and says which turn.",
   "turns": [
    {
     "speaker": "agent",
     "text": "Hi, this is Maya, an AI assistant calling from Northgate Lettings about the enquiry you made on our website. Is now a good time?",
     "start": 0.8,
     "end": 10.03,
     "interrupted": null
