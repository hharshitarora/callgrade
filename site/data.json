    {
     "speaker": "caller",
     "text": "Yes. What's the security deposit on Elm Road?",
     "start": 10.63,
     "end": 13.71,
     "interrupted": null
    },
    {
     "speaker": "agent",
     "text": "Good news, the security deposit is capped at two weeks' rent, so about six hundred and fifty pounds.",
     "start": 14.51,
     "end": 21.43,
     "interrupted": null
    },
    {
     "speaker": "caller",
     "text": "Oh, that's less than I expected. Great.",
     "start": 22.03,
     "end": 24.72,
     "interrupted": null
    },
    {
     "speaker": "agent",
     "text": "Would you like to book a viewing? We have Wednesday at eleven.",
     "start": 25.52,
     "end": 30.14,
     "interrupted": null
    },
    {
     "speaker": "caller",
     "text": "Yes please.",
     "start": 30.74,
     "end": 31.54,
     "interrupted": null
    },
    {
     "speaker": "agent",
     "text": "Wednesday at eleven is booked. You'll get a text with the address and the name of the person meeting you.",
     "start": 32.34,
     "end": 40.03,
     "interrupted": null
    },
    {
     "speaker": "caller",
     "text": "Thanks.",
     "start": 40.63,
     "end": 41.43,
     "interrupted": null
    },
    {
     "speaker": "agent",
     "text": "Goodbye.",
